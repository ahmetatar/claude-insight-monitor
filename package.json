{
  "name": "claude-insight-monitor",
  "version": "0.1.1",
  "description": "On/off toggleable proxy that captures every request Claude Code sends to the Anthropic API and shows the full context on a local web page.",
  "type": "commonjs",
  "bin": {
    "cmon": "bin/cli.js"
  },
  "main": "src/server.js",
  "files": [
    "bin/",
    "src/",
    "public/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "proxy",
    "observability",
    "tokens",
    "prompt-caching",
    "cli"
  ],
  "author": "Ahmet Atar",
  "license": "MIT",
  "homepage": "https://github.com/ahmetatar/claude-insight-monitor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmetatar/claude-insight-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/ahmetatar/claude-insight-monitor/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
